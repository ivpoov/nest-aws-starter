{
  "name": "nest-aws-starter",
  "version": "1.3.3",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "benchmark": "node scripts/benchmark.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "turbo run build",
    "docs:build": "turbo run docs:build",
    "license-check": "node scripts/license-check.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm run test:scripts",
    "test:scripts": "node --test scripts/subtraction-test.spec.mjs scripts/bootstrap.spec.mjs scripts/changelog.spec.mjs",
    "test:e2e": "turbo run test:e2e",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "autocannon": "8.0.0",
    "husky": "9.1.7",
    "turbo": "2.10.2"
  }
}
