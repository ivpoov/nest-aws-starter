# docker-compose overrides — defaults work out of the box for local development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter
# Host port for Postgres
POSTGRES_PORT=20010
# Host port for Redis
REDIS_PORT=20011
# Host ports for LocalStack and MinIO (shifted off the defaults for the same reason)
LOCALSTACK_PORT=20012
MINIO_PORT=20013
MINIO_CONSOLE_PORT=20014

# <module:stackport>
# StackPort — a browser for the AWS resources LocalStack emulates (SQS, SNS,
# SES, Lambda). Opt-in and development-only:
#
#   docker compose --profile tools up -d stackport
#
# It is NOT an S3 browser here: this project's S3 is MinIO, so use the MinIO
# console on MINIO_CONSOLE_PORT for buckets and objects.
#
# Every local service sits in the 20000-20023 band so the URLs are stable and
# nothing collides with another project; 20015 is StackPort's slot in it.
STACKPORT_PORT=20015
# </module:stackport>

# --- `full` profile only (docker compose --profile full) ---------------------
# Runs the built API image against the services above. Host port for it; 20005
# keeps it clear of a `pnpm start:dev` on 20000, so the two can be compared.
API_PORT=20005
# The image runs with NODE_ENV=production, which arms the boot guard, so the
# profile needs a real secret and ships none. Fill this in:
#   openssl rand -hex 48
API_JWT_SECRET=
