# docker-compose overrides — defaults work out of the box for local development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter
# Host port for Postgres (5433 avoids clashing with a locally running Postgres)
POSTGRES_PORT=5433
# Host port for Redis (6390 avoids clashing with a locally running Redis)
REDIS_PORT=6390
# Host ports for LocalStack and MinIO (shifted off the defaults for the same reason)
LOCALSTACK_PORT=4567
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- `full` profile only (docker compose --profile full) ---------------------
# Runs the built API image against the services above. Host port for it; 3080
# keeps it clear of a `pnpm start:dev` on 3000, so the two can be compared.
API_PORT=3080
# The image runs with NODE_ENV=production, which arms the boot guard, so the
# profile needs a real secret and ships none. Fill this in:
#   openssl rand -hex 48
API_JWT_SECRET=
