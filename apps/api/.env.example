PORT=3000
NODE_ENV=development
# Minimum log severity: verbose, debug, log, warn, error or fatal. Everything
# from the level named here upwards is written, everything below it is dropped.
# Unset, production uses `log` (so debug and verbose stay out of production
# logs) and everything else uses `verbose`. An unrecognised value refuses to
# boot rather than quietly logging less than you asked for.
LOG_LEVEL=verbose

API_PREFIX=api

# Swagger UI at /docs. Unset means "on everywhere except production".
# SWAGGER_ENABLED=true in production is allowed but never silent: the boot
# guard refuses to start unless SWAGGER_USER and SWAGGER_PASSWORD are both
# set, and the /docs routes then sit behind HTTP basic auth.
# SWAGGER_ENABLED=false
# SWAGGER_USER=
# SWAGGER_PASSWORD=

# Connection pool math: instances × connection_limit ≤ max_connections − reserved.
# Postgres defaults to max_connections=100 with ~3 reserved for superusers.
# One instance with connection_limit=10 leaves ample headroom; revisit this number
# on every scale-out — changing instance count without revisiting the pool size
# is a deploy error.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/starter?connection_limit=10

REDIS_URL=redis://localhost:6390
# Set true to connect to a Redis cluster (docker compose --profile cluster up -d; use redis://localhost:7000)
REDIS_IS_CLUSTER=false

# AWS — points at LocalStack/MinIO from docker compose; replace for real AWS
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 (MinIO locally). With S3_ENABLED=false none of the other S3_* vars are read;
# with true, region and bucket are required and validated at boot. S3_ENDPOINT
# unset = real AWS. S3_ACCESS_KEY/S3_SECRET_KEY are optional and belong together:
# set both for MinIO or any other non-AWS endpoint; leave both unset on AWS so the
# default credential provider chain signs with the instance/task role instead —
# setting only one of the two fails boot.
S3_ENABLED=true
S3_ENDPOINT=http://localhost:9010
S3_BUCKET_NAME=starter
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# CloudFront signed download URLs. With CLOUDFRONT_ENABLED=false, FileService
# falls back to presigned S3 GET urls (local/MinIO). With true, all are
# required and validated at boot. CLOUDFRONT_PRIVATE_KEY is the PEM content of
# the CloudFront key-pair's private key — literal "\n" sequences are normalized.
CLOUDFRONT_ENABLED=false
# CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=K2JCJMDEHXQW5F
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# CLOUDFRONT_URL_TTL_SEC=300

# SQS (LocalStack locally). Same enablement contract as S3.
SQS_ENABLED=true

# SNS (LocalStack locally). Same enablement contract as S3.
SNS_ENABLED=true

# Mail via SES (LocalStack locally; the init script verifies the identity below)
MAIL_ENABLED=true
MAIL_FROM_ADDRESS=no-reply@example.com

# Lambda invoker (LocalStack locally). Same enablement contract as S3.
LAMBDA_ENABLED=true

# Auth core — required. The value below is a development default: with
# NODE_ENV=production the app refuses to boot while it is still in place, and
# also refuses any secret carrying under 32 bytes (256 bits) of measurable
# entropy — length is not entropy, so 64 repeated characters score zero.
# Generate a real one with: openssl rand -hex 48
AUTH_JWT_SECRET=local-development-secret-change-me-32chars
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_SEC=2592000
# How long a just-rotated refresh token can still be replayed, so two tabs
# refreshing at the same moment both get the winner's pair. Sized to one HTTP
# round trip (the only thing it needs to cover), not to user think-time —
# anything longer is exposure, not concurrency. See auth.config.ts.
AUTH_REFRESH_GRACE_SEC=10

# Read the client ip from X-Forwarded-For. X-Forwarded-For is written by
# whoever sends the request, so this must be true ONLY when every request
# arrives through a proxy you control that overwrites it (ALB, CloudFront). If
# clients can reach the API directly, leaving this true lets any of them forge
# an ip and mint themselves a fresh rate-limit budget per request. It is true
# here because the e2e suite fronts the app itself and varies client ips per
# request; the off case is covered by test/proxy-spoofing.e2e-spec.ts.
TRUST_PROXY=true

# Where email links (verify, reset) point — the web app
WEB_APP_BASE_URL=http://localhost:5173
# comma-separated browser origins allowed by CORS (web + admin dev servers by
# default). Outside production these are not the only origins accepted: any
# http://localhost:<port>, http://127.0.0.1:<port> or http://[::1]:<port> is
# allowed as well, so a Vite dev server that fell back to 5175 because 5173 was
# taken still reaches the API without editing this line. That latitude is
# development-only — it is decided from NODE_ENV inside the origin check, never
# by widening this list — and it is off under NODE_ENV=production, where these
# exact entries are the whole allowlist. In production the app also refuses to
# boot if this is unset, contains a wildcard, or lists a loopback address.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Google OAuth (register the app in Google Cloud Console; buttons hide while disabled)
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

# Facebook OAuth (register the app at Meta for Developers)
FACEBOOK_OAUTH_ENABLED=false
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/facebook/callback

# Discord OAuth (register the app at the Discord Developer Portal)
DISCORD_OAUTH_ENABLED=false
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/discord/callback

# Send an email alert when a login is seen from a device with no recent
# session (requires MAIL_ENABLED=true — silently skipped otherwise)
NEW_DEVICE_EMAIL_ENABLED=false

# Scheduled jobs (task-scheduler module). Defaults to true here; the e2e
# harness (apps/api/test/vitest.e2e.config.ts) pins this to false so cron
# ticks don't add noise to unrelated suites — this file's value only governs
# local/dev/CI-non-e2e runs.
SCHEDULER_ENABLED=true

# Stripe payments (test-mode keys from the Stripe dashboard). With
# STRIPE_ENABLED=false, /billing/checkout and /billing/portal return
# PAYMENT_PROVIDER_NOT_ENABLED — no provider registers. With true,
# secretKey/webhookSecret/portalReturnUrl are required and validated at
# boot. The Stripe API version is pinned in code (not env-configurable) to
# match the installed SDK's types. portalReturnUrl is the web app's base
# URL — /billing/success and /billing/canceled are appended for Checkout.
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_RETURN_URL=http://localhost:5173

# Webhook ingest queue (POST /webhooks/:provider enqueues {webhookEventId}
# here). LocalStack locally: docker/localstack/init-aws.sh provisions
# starter-payment-webhook-queue. Not gated by SQS_ENABLED — if SQS is
# disabled or this URL is wrong, the endpoint still 200s immediately and
# just logs the enqueue failure (see WebhookIngestService).
SQS_PAYMENT_WEBHOOK_QUEUE_URL=http://localhost:4567/000000000000/starter-payment-webhook-queue

# Webhook consumer long-poll loop (PaymentWebhookConsumerService). Defaults
# to true here; the e2e harness (apps/api/test/vitest.e2e.config.ts) pins
# this to false so suites drive message processing directly instead of
# racing the loop's poll interval — this file's value only governs
# local/dev/CI-non-e2e runs.
PAYMENT_WEBHOOK_CONSUMER_ENABLED=true

# Socket.IO notification gateway (Redis-adapter backed, multi-instance
# safe). Handshake carries the access token in `auth.token`, validated like
# HTTP (signature + Redis allowlist); a background sweep re-validates every
# connected socket every WEBSOCKET_HEARTBEAT_INTERVAL_MS so a force-logout
# severs live sockets, not just future HTTP requests. The e2e harness
# (apps/api/test/vitest.e2e.config.ts) lowers the interval so the
# revocation e2e spec doesn't wait a full 60s.
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL_MS=60000
# Socket limits. A socket server accepts work before it decides whether it wants
# it, and none of these had a ceiling before: one valid token could open
# unbounded connections, each costing a JWT verify and a Redis read on every
# heartbeat tick, and the handshake itself was the one unmetered entry point in
# the application (ThrottlerGuard only ever sees @SubscribeMessage handlers, and
# this gateway has none).
WEBSOCKET_MAX_CONNECTIONS_PER_USER=10
WEBSOCKET_HANDSHAKES_PER_MINUTE_PER_IP=30
WEBSOCKET_HEARTBEAT_CONCURRENCY=25
# Clients never send anything on this socket, so socket.io's 1MB default frame
# buffer is attack surface with no legitimate user.
WEBSOCKET_MAX_PAYLOAD_BYTES=8192

