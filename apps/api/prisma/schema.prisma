generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthMethodType {
  EMAIL
  GOOGLE
  FACEBOOK
  DISCORD
}

model User {
  id          String       @id @default(uuid(7))
  role        UserRole     @default(USER)
  status      UserStatus   @default(ACTIVE)
  displayName String       @db.VarChar(120)
  avatarKey   String? // S3 object key, served via presigned URL
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  authMethods AuthMethod[]
  sessions    Session[]

  @@index([role, status])
  @@map("users")
}

model AuthMethod {
  id                String         @id @default(uuid(7))
  userId            String
  type              AuthMethodType
  email             String?        @db.VarChar(320) // verified email (EMAIL + most OAuth)
  isEmailVerified   Boolean        @default(false)
  passwordHash      String? // EMAIL only
  providerAccountId String? // OAuth only — provider's stable user id
  createdAt         DateTime       @default(now())
  lastUsedAt        DateTime?
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, providerAccountId])
  @@unique([userId, type]) // one method per type per user
  @@unique([type, email]) // conflict rule backbone (EMAIL row per address)
  @@index([email])
  @@index([userId])
  @@map("auth_methods")
}

// Metadata only — powers the sessions pages. No token material lives in
// Postgres, ever: all tokens are TTL'd Redis allowlist keys (see token module);
// a session is alive iff its Redis refresh key exists.
model Session {
  id           String   @id @default(uuid(7))
  userId       String
  device       String   @db.VarChar(255) // parsed "Chrome on Fedora"
  ip           String   @db.VarChar(45)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  activeUntil  DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activeUntil])
  @@map("sessions")
}

enum NoteStatus {
  ACTIVE
  ARCHIVED
}

model Note {
  id        String     @id @default(uuid(7))
  title     String     @db.VarChar(255)
  body      String     @default("")
  status    NoteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@map("notes")
}
