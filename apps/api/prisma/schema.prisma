generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthMethodType {
  EMAIL
  GOOGLE
  FACEBOOK
  DISCORD
}

model User {
  id                      String                   @id @default(uuid(7))
  role                    UserRole                 @default(USER)
  status                  UserStatus               @default(ACTIVE)
  displayName             String                   @db.VarChar(120)
  avatarKey               String? // S3 object key, served via presigned URL
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  authMethods             AuthMethod[]
  sessions                Session[]
  // Sessions this user (as an admin) is currently impersonating a target
  // through — back-relation only, never queried from the User side today.
  impersonatedByMe        Session[]                @relation("SessionSignedAsAdmin")
  notes                   Note[] // <module:note>
  files                   File[] // <module:file>
  apiKeys                 ApiKey[] // <module:api-key>
  subscriptions           Subscription[] // <module:payment>
  paymentTransactions     PaymentTransaction[] // <module:payment>
  notificationPreferences NotificationPreference[] // <module:notification>
  notifications           Notification[] // <module:notification>
  notificationReceipts    NotificationReceipt[] // <module:notification>

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model AuthMethod {
  id                String         @id @default(uuid(7))
  userId            String
  type              AuthMethodType
  email             String?        @db.VarChar(320) // verified email (EMAIL + most OAuth)
  isEmailVerified   Boolean        @default(false)
  passwordHash      String? // EMAIL only
  providerAccountId String? // OAuth only — provider's stable user id
  createdAt         DateTime       @default(now())
  lastUsedAt        DateTime?
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, providerAccountId])
  @@unique([userId, type]) // one method per type per user
  @@unique([type, email]) // conflict rule backbone (EMAIL row per address)
  @@index([email])
  @@index([userId])
  @@map("auth_methods")
}

// Metadata only — powers the sessions pages. No token material lives in
// Postgres, ever: all tokens are TTL'd Redis allowlist keys (see token module);
// a session is alive iff its Redis refresh key exists.
model Session {
  id              String   @id @default(uuid(7))
  userId          String
  device          String   @db.VarChar(255) // parsed "Chrome on Fedora"
  ip              String   @db.VarChar(45)
  createdAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())
  activeUntil     DateTime
  // Set only for sessions minted by admin login-as — the token's optional
  // actAsBy claim is re-derived from this column on every refresh, never
  // trusted from the old token.
  signedAsAdminId String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedAsAdmin   User?    @relation("SessionSignedAsAdmin", fields: [signedAsAdminId], references: [id])

  @@index([userId, activeUntil])
  @@index([signedAsAdminId])
  @@index([activeUntil])
  @@map("sessions")
}

// <module:note>
enum NoteStatus {
  ACTIVE
  ARCHIVED
}

model Note {
  id        String     @id @default(uuid(7))
  userId    String
  title     String     @db.VarChar(255)
  body      String     @default("")
  status    NoteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UUIDv7 cursor pagination scans per owner
  @@index([userId, id])
  @@index([status])
  @@map("notes")
}

// </module:note>

enum ActivityType {
  USER_REGISTERED
  USER_OAUTH_REGISTERED
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_PASSWORD_CHANGED
  AUTH_METHOD_LINKED
  AUTH_METHOD_UNLINKED
  USER_BLOCKED
  USER_UNBLOCKED
  AUTH_SUSPICIOUS_LOGIN
  AUTH_NEW_DEVICE
  ADMIN_LOGIN_AS
  CONTACT_RECEIVED
  FILE_UPLOADED
  API_KEY_CREATED
  API_KEY_REVOKED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PAST_DUE
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRED
}

// Append-only audit trail, driven entirely by domain events — no relation to
// User on purpose: rows must survive independently of user lifecycle changes
// and actorId/userId are both plain references, never enforced FKs.
model Activity {
  id        String       @id @default(uuid(7))
  userId    String?
  actorId   String?
  sessionId String?
  type      ActivityType
  meta      Json?
  ip        String?      @db.VarChar(45)
  createdAt DateTime     @default(now())

  @@index([userId, id])
  @@index([type, id])
  @@index([type, createdAt])
  @@map("activities")
}

// <module:contact-us>
enum ContactMessageStatus {
  OPEN
  RESOLVED
}

// Public contact-form submissions — not append-only like Activity: an admin
// resolving a message is a genuine update, so updatedAt is real.
model ContactMessage {
  id        String               @id @default(uuid(7))
  name      String               @db.VarChar(120)
  email     String               @db.VarChar(320)
  subject   String               @db.VarChar(200)
  body      String               @db.VarChar(5000)
  status    ContactMessageStatus @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Admin inbox cursor: filter by status, page by id (UUIDv7 = creation order).
  @@index([status, id])
  @@map("contact_messages")
}

// </module:contact-us>

// <module:file>
enum FileIntent {
  AVATAR
  ATTACHMENT
}

enum FileStatus {
  PENDING
  READY
}

// Formalizes what avatars started: a presigned-upload/confirm/download flow
// backed by S3, with PENDING rows written before the client has actually put
// bytes. Orphan PENDING rows (client requests an upload but never confirms)
// are swept by OrphanFileSweepJob (modules/file/jobs) — see
// modules/file/README.md.
model File {
  id          String     @id @default(uuid(7))
  ownerId     String
  intent      FileIntent
  key         String     @unique
  contentType String
  size        Int
  status      FileStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, id])
  // Backs OrphanFileSweepJob's findStalePending(cutoff) query.
  @@index([status, createdAt])
  @@map("files")
}

// </module:file>

// <module:api-key>
// Long-lived service credentials, deliberately modeled in Postgres rather
// than as Redis sessions — they are issued once, live for months/years, and
// must survive independently of any single request/refresh cycle. The
// plaintext key is shown exactly once at creation; only its sha256 (unique,
// used for guard lookups) and a short display prefix are ever persisted.
// Revocation is a soft delete (revokedAt) — keys are auditable credentials,
// never hard-deleted.
model ApiKey {
  id         String    @id @default(uuid(7))
  name       String    @db.VarChar(120)
  hashedKey  String    @unique
  prefix     String    @db.VarChar(12)
  ownerId    String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // UUIDv7 cursor pagination scans for the admin list
  @@index([ownerId, id])
  @@map("api_keys")
}

// </module:api-key>

// <module:payment>
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TransactionStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

model Plan {
  id            String         @id @default(uuid(7))
  name          String         @db.VarChar(120)
  description   String         @default("")
  amountCents   Int
  currency      String         @db.VarChar(3)
  intervalDays  Int // 30 / 365 — provider-agnostic interval
  providerRefs  Json           @default("{}") // { "STRIPE": "price_..." } — per-provider price ids
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

// Financial records outlive the account they belong to. The same retention
// reasoning the Activity audit trail already documents applies here with more
// force: a subscription and its charges are what a chargeback, a tax audit or
// a revenue reconciliation is argued from, and `onDelete: Cascade` quietly
// destroyed all of it the first time anyone deleted a user row. The relations
// below are Restrict instead, so Postgres refuses the delete rather than
// silently erasing the money trail. There is deliberately no user-erasure
// endpoint in this starter (users are BLOCKED, never deleted); whoever adds
// one must decide explicitly what happens here — the intended shape is to
// anonymize the payment rows (drop the FK, keep amounts, dates and provider
// refs) and only then delete the user, never to cascade.
model Subscription {
  id                  String               @id @default(uuid(7))
  userId              String
  planId              String
  status              SubscriptionStatus
  provider            String               @db.VarChar(30) // 'STRIPE'
  providerRef         String?              @db.VarChar(255) // sub_... (unique per provider)
  providerCustomerRef String?              @db.VarChar(255) // provider's customer id — needed by the billing portal; populated by the checkout.completed webhook (PR 7)
  currentPeriodEndsAt DateTime
  canceledAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                Plan                 @relation(fields: [planId], references: [id])
  transactions        PaymentTransaction[]

  @@unique([provider, providerRef])
  @@index([userId, status])
  @@index([status, currentPeriodEndsAt]) // expiry sweep
  @@map("subscriptions")
}

model PaymentTransaction {
  id             String            @id @default(uuid(7))
  userId         String
  subscriptionId String?
  status         TransactionStatus
  amountCents    Int
  currency       String            @db.VarChar(3)
  provider       String            @db.VarChar(30)
  providerRef    String            @db.VarChar(255) // payment_intent / charge id
  createdAt      DateTime          @default(now())
  // Restrict, for the retention reasons documented on Subscription above.
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, providerRef])
  @@index([userId, id])
  @@index([status, createdAt]) // revenue TypedSQL
  @@map("payment_transactions")
}

model WebhookEvent {
  id              String             @id @default(uuid(7))
  provider        String             @db.VarChar(30)
  providerEventId String             @db.VarChar(255)
  type            String             @db.VarChar(120)
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  lastError       String?
  createdAt       DateTime           @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId]) // idempotency backbone
  @@index([status, createdAt])
  @@map("webhook_events")
}

// </module:payment>

// <module:notification>
enum NotificationAudience {
  USER // targeted at one user
  ADMIN // broadcast to the admin role
}

model Notification {
  id        String                @id @default(uuid(7))
  audience  NotificationAudience
  userId    String? // set when audience = USER
  type      String                @db.VarChar(60) // NotificationTypeEnum (shared)
  title     String                @db.VarChar(200)
  body      String                @db.VarChar(1000)
  meta      Json                  @default("{}") // deep-link data, denormalized
  createdAt DateTime              @default(now())
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts  NotificationReceipt[]

  @@index([userId, id])
  @@index([audience, id])
  @@map("notifications")
}

model NotificationReceipt {
  id             String       @id @default(uuid(7))
  notificationId String
  userId         String // reader (admin id for ADMIN audience)
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_receipts")
}

model NotificationPreference {
  id      String  @id @default(uuid(7))
  userId  String
  type    String  @db.VarChar(60)
  channel String  @db.VarChar(20) // 'EMAIL'
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

// </module:notification>
