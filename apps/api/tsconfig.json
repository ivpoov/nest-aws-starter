{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "strict": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@providers/*": ["./src/modules/common/providers/*"],
      "@decorators/*": ["./src/modules/common/decorators/*"],
      "@guards/*": ["./src/modules/common/guards/*"],
      "@helpers/*": ["./src/modules/common/helpers/*"],
      "@constants/*": ["./src/modules/common/constants/*"],
      "@interfaces/*": ["./src/modules/common/interfaces/*"],
      "@configs/*": ["./src/configs/*"],
      "@generated/*": ["./src/generated/*"],
      "@src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
