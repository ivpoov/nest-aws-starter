{
  "name": "@nest-aws-starter/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --sql && tsc --noEmit -p tsconfig.build.json && swc src -d dist --strip-leading-paths --quiet",
    "start:dev": "swc src -d dist --strip-leading-paths --quiet && concurrently \"swc src -d dist --strip-leading-paths -w --quiet\" \"node --watch dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "biome check src",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./test/vitest.e2e.config.ts",
    "db:generate": "prisma generate --sql",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1079.0",
    "@aws-sdk/client-s3": "3.1079.0",
    "@aws-sdk/client-ses": "3.1079.0",
    "@aws-sdk/client-sns": "3.1079.0",
    "@aws-sdk/client-sqs": "3.1079.0",
    "@aws-sdk/cloudfront-signer": "3.1078.0",
    "@aws-sdk/s3-request-presigner": "3.1079.0",
    "@casl/ability": "7.0.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.2",
    "@nest-aws-starter/shared": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-fastify": "11.1.27",
    "@nestjs/platform-socket.io": "11.1.27",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.27",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cron": "4.4.0",
    "fastify": "5.8.5",
    "http-status-codes": "2.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "stripe": "22.3.0",
    "ua-parser-js": "2.0.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.27",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.43",
    "@types/node": "24.13.2",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "concurrently": "9.2.3",
    "dotenv": "17.4.2",
    "prisma": "7.8.0",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.9",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.9"
  }
}
