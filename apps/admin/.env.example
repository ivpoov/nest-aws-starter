VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WEB_APP_URL=http://localhost:5173

# Origins that serve presigned avatars and downloads (space- or comma-separated).
# Build-time only: it narrows the shipped Content-Security-Policy. Leave it
# unset and the policy falls back to the `https:` wildcard, which authorises
# every TLS origin there is. Set it to your bucket or CloudFront distribution
# in production, or to your MinIO origin when previewing a production build.
# VITE_MEDIA_ORIGINS=https://cdn.example.com

# The product name shown on the login screen, in the admin sidebar and in the
# browser tab. Rename here and every screen follows; the admin console derives
# "<name> Admin" from the same value. Defaults to "Starter" when unset.
# VITE_PRODUCT_NAME=Acme
